%% aidea 自包含 .dmg GUI — 类 / 接口图（增量：Ollama → llama.cpp llama-server）
%% 变更点：OllamaBoot → LlamaCppBoot；新增 LlamaCppServer sidecar；
%%          本地推理后端 Local 复用 OpenAiLlm / OpenAiCompletionBackend（指向 127.0.0.1 的 llama-server）。

classDiagram
    direction LR

    %% ---------- Rust 端：全局状态 ----------
    class AppState {
        +clients: GrpcClients
        +vendor: VendorConfig
        +bootstrap: BootstrapHandles
        +aborts: HashMap~String, CancellationToken~
        +store: Store
        +comment_store / secret_store / lock_store
        +conn_status: Mutex~ConnStatus~
    }
    class VendorConfig {
        +kind: "local"|"online"
        +base_url: Option~String~
        +local_model: String
    }
    class BootstrapHandles {
        +pg: Child
        +llamacpp: Child
        +serve: Child
        +phase: Mutex~BootstrapPhase~
    }
    class GrpcClients {
        +agent: AgentServiceClient~Channel~
        +health: HealthServiceClient~Channel~
    }
    class GuiError { +code: String +message: String }

    %% ---------- Rust 端：Bootstrap / sidecar ----------
    class Bootstrap {
        +bootstrap_stack(cfg) BootstrapState
        +stop_all()
    }
    class Sidecar {
        +spawn(name, args, env) Child
        +supervise(child)
        +bin_path(name) PathBuf
    }
    class PgBoot {
        +initdb_if_needed() +start() +createdb() +apply_migrations()
    }
    class LlamaCppBoot {
        +start()  %% 启动 llama-server --model <gguf> --host 127.0.0.1 --port <p>
        +wait_ready()  %% 轮询端口
    }
    class ServeBoot {
        +start_with_env(vendor) +wait_health()
    }
    class ModelBackend {
        +to_serve_env(cfg) Vec~(String,String)~
        +test_vendor(base_url, key) bool
    }

    %% ---------- 新：llama.cpp sidecar ----------
    class LlamaCppServer {
        <<sidecar: llama-server>>
        +port: u16 = 8080
        +model_path: GGUF
        +base_url: http://127.0.0.1:8080/v1
        +OpenAI 兼容: /v1/chat/completions /v1/completions /v1/embeddings /health
    }

    %% ---------- Rust 端：Tauri Commands ----------
    class Commands {
        <<module>>
        +bootstrap_status() BootstrapState
        +get_vendor_config() VendorConfig
        +set_vendor_config(cfg) void
        +test_vendor(req) bool
        +connect_status() ConnStatus
        +chat_send/stop(req)
        +agent_run(req)
        +quest_run(req) QuestReport
        +craft_propose/confirm/reject(req)
        +comment_*/lock_*/secret_*
        +fetch_health/console/metrics()
    }

    %% ---------- Rust 端：gRPC + 领域复用 ----------
    class GrpcStream { +run_chat() +run_agent() }
    class QuestService { +run(goal) QuestReport }
    class CraftService { +propose()/confirm() }
    class CollabService { +comment/lock/secret stores }

    class IdeCore {
        <<external: ide_core::v1>>
        +AgentServiceClient / HealthServiceClient
        +ChatRequest / ChatMessage / AgentRequest / AgentEvent
    }
    class IdeCoreDomain {
        <<external: ide_core>>
        +quest::Quest / craft::CraftEngine
        +collab / security::PgSecretStore / CoreConfig
    }

    %% ---------- 服务端推理后端（ide-core，复用既有 OpenAI 兼容实现） ----------
    class LlmBackend {
        <<enum>>
        +Mock / Local / OpenAi
    }
    class NesBackend {
        <<enum>>
        +Mock / Local / OpenAi
    }
    class OpenAiLlm {
        +base_url +api_key +model
        +impl Llm: think()/plan_action()
        %% Local 模式：base_url=http://127.0.0.1:8080/v1，api_key=""
    }
    class OpenAiCompletionBackend {
        +base_url +api_key +model
        +impl CompletionBackend: complete()
        %% Local 模式：base_url=http://127.0.0.1:8080/v1
    }
    class NesClient {
        +cache +degradation +batch
        +with_backend(Arc~dyn CompletionBackend~)
        +embed()  %% 走 llama-server /v1/embeddings（可选）
    }

    %% ---------- 前端 ----------
    class ModelStore { +vendor +setVendor()/test() }
    class ConnectionStore { +status +bootstrap }
    class ChatStore { +sessions +send()/stop() }
    class QuestStore { +history +run() }
    class CraftStore { +proposal +confirm/reject }
    class CollabStore { +comments/locks/secrets }
    class HealthStore { +overview +fetch() }
    class Pages {
        <<module>>
        +BootstrapPage +SettingsPage
        +ChatPage +QuestPage +CraftPage +CollabPage +HealthPage
    }
    class InvokeApi { +invoke() +listen() }

    %% ---------- 关系 ----------
    AppState --> GrpcClients
    AppState --> VendorConfig
    AppState --> BootstrapHandles
    Commands ..> AppState
    Commands ..> Bootstrap
    Commands ..> ModelBackend
    Commands ..> GrpcStream
    Commands ..> QuestService
    Commands ..> CraftService
    Commands ..> CollabService

    Bootstrap ..> Sidecar
    Bootstrap ..> PgBoot
    Bootstrap ..> LlamaCppBoot
    Bootstrap ..> ServeBoot
    ModelBackend ..> ServeBoot : env
    ServeBoot ..> IdeCore : 启动 aidea serve
    GrpcClients ..> IdeCore
    QuestService ..> IdeCoreDomain
    CraftService ..> IdeCoreDomain
    CollabService ..> IdeCoreDomain

    LlamaCppBoot ..> Sidecar : spawn llama-server
    LlamaCppBoot ..> LlamaCppServer : HTTP /v1/*
    IdeCore ..> OpenAiLlm : Local 走 /v1/chat/completions
    IdeCore ..> NesClient : Local 走 OpenAiCompletionBackend
    NesClient o-- OpenAiCompletionBackend
    OpenAiLlm ..> LlamaCppServer : /v1/chat/completions
    OpenAiCompletionBackend ..> LlamaCppServer : /v1/chat|completions
    LlmBackend <.. OpenAiLlm : Local 构造
    NesBackend <.. NesClient : Local 构造

    Pages ..> InvokeApi
    InvokeApi ..> Commands
    Pages ..> BootstrapPage
    Pages ..> SettingsPage
    Pages ..> ChatStore
    Pages ..> QuestStore
    Pages ..> CraftStore
    Pages ..> CollabStore
    Pages ..> HealthStore
    Pages ..> ModelStore
    Pages ..> ConnectionStore
